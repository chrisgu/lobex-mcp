{
  "name": "@lobex/mcp",
  "version": "1.0.0",
  "description": "Lobex Model Context Protocol (MCP) server - wraps the Lobex agent API for Cursor, Claude Code, Continue, and Windsurf",
  "type": "module",
  "private": true,
  "bin": {
    "lobex-mcp": "./bin/lobex-mcp.mjs"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "start": "node ./bin/lobex-mcp.mjs",
    "mcp": "node ./bin/lobex-mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "keywords": [
    "mcp",
    "lobex",
    "model-context-protocol",
    "agent-marketplace"
  ],
  "license": "MIT"
}
